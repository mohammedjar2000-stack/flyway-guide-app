# Copy these into a local `.env` file. Never commit real secrets.
# GEOAPIFY_API_KEY, RAPIDAPI_KEY, and DATABASE_URL are server-only — do not prefix them with VITE_.
# Never put the Supabase service-role key in the frontend.
# Restrict VITE_GOOGLE_PLACES_API_KEY by HTTP referrer in Google Cloud Console.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/flyway
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=
RAPIDAPI_KEY=
API_PORT=8787

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_PLACES_API_KEY=
# Optional extra admin PIN. The dashboard also accepts the built-in passcode admin123.
# Unlock state is stored in localStorage so refresh does not re-prompt.
VITE_ADMIN_PIN=
